  "findings": [
    {
      "id": "panic-outcome",
      "problem": "The prior capability evaluator discarded the Rust should-panic marker and accepted a native pass label with either exit 0 or 101 for every test. A normal test panic and a should-panic test without a panic could pass.",
      "fix": "Bind exact test names, status, observed exit, and default-hook single-line payload/location to the pinned Rust --show-output oracle. Reject malformed duplicate JSON fields, absent captures, wrong payload/location, unexpected normal/ignored output, booleans as counts and empty execution. The strict output parser is bounded to the pinned attributes fixture.",
      "before": "capability-baseline.stderr",
      "after": "final-test-capability-results.json"
    },
    {
      "id": "fixed-inventory",
      "problem": "Upstream capability probe declarations and retained-history row classification were mutable inputs. Required rows could be deleted or reclassified before a candidate run.",
      "fix": "Bind the complete upstream capability fixture tree, probe declaration script, exact retained upstream tree, integration exception and unresolved-count map to the pinned Lust revision before candidate execution. Keep the 18 declared supported probes and 349 required/13 unresolved histories. Unresolved histories remain unqualified.",
      "after": [
        "final-test-capability-results.json",
        "retained-pinned-oracle.stderr",
        "retained-pinned-oracle-records/identities.json"
      ]
    },
    {
      "id": "retired-acquisition",
      "problem": "Active measurement entry points and standalone qualifier launchers still constructed or invoked retired whole-compiler/coordinator packages.",
      "fix": "Delete four unused mixed-driver launchers and unused acquisition pipelines. Make six old Python CLIs reject acquisition; keep only explicit historical replay/report readers and record models whose real child/daemon sinks are disabled. Remove routed tests-via and mixed campaign acquisition; reject native_state in the general independent command runner before execution/output.",
      "after": [
        "final-test-retired-acquisition.json",
        "final-gate-controls.json"
      ]
    },
    {
      "id": "cargo-results",
      "problem": "The direct Cargo gate accepted incomplete, inconsistent, duplicated or filtered result summaries and did not bind names to each observed harness group. Optional integration tests silently returned success when their required inputs were absent.",
      "fix": "Require nonempty actual passing work, complete numeric counts matching unique individual outcomes, no failed/measured/filtered tests, and per-group passed/ignored names. Mark external-input tests explicitly ignored, requiring inputs when selected. Replace obsolete routed tests with unconditional refusal controls.",
      "after": [
        "final-gate-controls.json",
        "direct-cargo-gate.json"
      ]
    },
    {
      "id": "trigger-coverage",
      "problem": "The Compiler-set hand-maintained path list omitted actual upstream/bluefe-core.pin and did not protect future compiler inputs; historical replay workflows omitted imported shared helpers.",
      "fix": "Use source input families including Cargo/config/toolchain/submodule declarations, examples, library, compiler, crates, upstream, tools and workflows. Add regression checks on the triggers themselves and shared historical replay inputs. The semantic research pin remains crates/lustr-semantic/rust-toolchain.toml at Nov 5; no upstream/rust-semantic.pin exists.",
      "after": "final-workflow-input-coverage.json"
    }
  ],
