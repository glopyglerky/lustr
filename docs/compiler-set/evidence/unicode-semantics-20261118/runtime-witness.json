    "bytes": 724,
    "source": "const LOWER_CONST: bool = '\\u{558}'.is_lowercase();\nconst UPPER_CONST: bool = '\\u{a7dd}'.is_uppercase();\nconst VERSION: (u8, u8, u8) = char::UNICODE_VERSION;\n\nfn main() {\n    // Runtime inputs arrive after compilation; the predicate results cannot\n    // be replaced with either constant above by evaluating the source alone.\n    let mut args = std::env::args().skip(1);\n    let lower = args.next().unwrap().chars().next().unwrap();\n    let upper = args.next().unwrap().chars().next().unwrap();\n    println!(\"version {:?}\", VERSION);\n    println!(\"inputs {} {}\", lower as u32, upper as u32);\n    println!(\"const {} {}\", LOWER_CONST, UPPER_CONST);\n    println!(\"runtime {} {}\", lower.is_lowercase(), upper.is_uppercase());\n}\n",
