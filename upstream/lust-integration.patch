+/// One native request between checking and emission. There is no Clone and no
+/// constructor outside this module. The session and request remain exclusively
+/// borrowed, so no later request can mutate the retained facts before emission.
+/// Program, IR, local type arenas and read sets are moved here, never rebuilt.
+pub struct PreparedRequest<'a> {
+    request: &'a Request,
+    session: &'a mut Session,
+    state: Option<CheckedRequest>,
+}
+
+struct OwnedBody {
+    body: ir::BodyData<crate::ty::OwnedTys>,
+    environment: Option<LocalDefId>,
+}
+
+impl OwnedBody {
+    fn take(body: ir::Body<'_>, program: &collect::Program) -> Result<Self, &'static str> {
+        if !std::ptr::eq(body.tys.global, &program.tys) {
+            return Err("checked body belongs to another global type store");
+        }
+        let environment = if body.tys.env.is_empty() {
+            None
+        } else {
+            let expected = program.gx.fn_scopes.get(body.fn_id.0 as usize)
+                .ok_or("checked body has no owning predicate environment")?;
+            if !std::ptr::eq(body.tys.env, expected.env.as_slice()) {
+                return Err("checked body belongs to another predicate environment");
+            }
+            Some(body.fn_id)
+        };
+        Ok(Self { body: body.map_types(crate::ty::Tys::detach), environment })
+    }
+
+    fn attach(self, program: &collect::Program) -> ir::Body<'_> {
+        // Both the program and this body are privately owned by CheckedRequest;
+        // no mutation or substitution can occur between take and attach.
+        let env = self.environment.map_or(&[][..], |id| program.gx.fn_scopes[id.0 as usize].env.as_slice());
+        self.body.map_types(|tys| tys.attach(&program.tys, env))
+    }
+}
+
+struct CheckedRequest {
+    program: collect::Program,
+    results: Vec<(Option<OwnedBody>, Vec<Diag>)>,
+    reemit: Vec<(usize, OwnedBody)>,
+    map: SourceMap,
+    source: String,
+    path: String,
+    work: Vec<usize>,
+    fn_count: usize,
+    fn_lines_all: Vec<u32>,
+    body_hashes_all: Vec<u64>,
+    inst_ids: Vec<(u32, u64)>,
+    mode: &'static str,
+    check_fp: Option<u64>,
+    verified: u64,
+    reads_reused: usize,
+    reads_invalidated: usize,
+    reemitted: usize,
+    mixed: bool,
+    release: bool,
+    foreign: bool,
+    visits: Visits,
+    timer: Timer,
+    imported_dependencies: Vec<super::imports::Dependency>,
+    imported_emission: Option<Box<dyn super::imports::Emission + 'static>>,
+    build_outputs: Vec<super::buildscript::Outputs>,
+}
+
+impl PreparedRequest<'_> {
+    pub fn request(&self) -> &Request {
+        self.request
+    }
+
+    /// Actual semantic facts for this request, held immutable until emission.
+    pub fn program(&self) -> &collect::Program {
+        &self.state.as_ref().expect("checked request is consumed").program
+    }
+
+    /// Body ids checked in this invocation. Other passing bodies were reused
+    /// only after the existing native dependency-read validation.
+    pub fn checked_functions(&self) -> &[usize] {
+        &self.state.as_ref().expect("checked request is consumed").work
+    }
+
+    pub fn source_map(&self) -> &SourceMap {
+        &self.state.as_ref().expect("checked request is consumed").map
+    }
+
+    pub fn source(&self) -> &str {
+        &self.state.as_ref().expect("checked request is consumed").source
+    }
+
+    /// Collect the original resolver's file inventory and actual expansion reads.
+    pub(crate) fn executable_source_inputs(&self) -> Result<ExecutableSourceInputs, &'static str> {
+        let map = self.source_map();
+        let cwd = &self.request.session.library.as_ref().ok_or("missing executable context")?.working_directory;
+        let mut inputs = ExecutableSourceInputs::default();
+        for index in 1..map.file_count() {
+            let file = FileId(index as u32);
+            let path = std::path::Path::new(map.path(file));
+            if path.as_os_str().is_empty() { continue; } // A retired source-map slot.
+            if !path.is_absolute() || map.text(file).is_none() {
+                return Err("unrepresented executable source file");
+            }
+            inputs.files.push(path.strip_prefix(cwd).unwrap_or(path).to_path_buf());
+        }
+        for dep in self.session.front.chunks.iter().flat_map(|chunk| &chunk.expand_deps) {
+            match dep {
+                expand::Dep::File { path, .. } => {
+                    if !path.is_absolute() { return Err("unbound executable include file"); }
+                    inputs.files.push(path.strip_prefix(cwd).unwrap_or(path).to_path_buf());
+                    inputs.has_include = true;
+                }
+                expand::Dep::Env { name, value } => {
+                    if inputs.environment.insert(name.clone(), value.clone()).is_some_and(|old| old != *value) {
+                        return Err("conflicting executable environment reads");
+                    }
+                }
+                _ => {}
+            }
+        }
+        Ok(inputs)
+    }
+
+    /// Combine resolved module imports with actual signature reads from
+    /// checked and reused bodies.
+    pub(crate) fn executable_extern_uses(&self) -> Option<std::collections::BTreeSet<crate::def::CrateId>> {
+        let program = self.program();
+        if program.ast.items.iter().chain(&program.ast.stmt_items).any(|item| {
+            matches!(item.kind, crate::ast::ItemKind::Use(_) | crate::ast::ItemKind::ExternCrate(_))
+        }) { return None; }
+        let mut used = program.resolved.as_ref()?.executable_import_uses.clone()?;
+        let caches = &self.session.caches;
+        for &slot in &self.session.front.fn_slot {
+            if let Some(Some(reads)) = caches.slot_reads.get(slot as usize) {
+                for (key, read) in reads.iter(&caches.read_keys) {
+                    if let super::graph::ReadKey::Sig(definition) = key
+                        && !read.failed && program.imported_crates.contains_key(&definition.krate) {
+                        used.insert(definition.krate);
+                    }
+                }
+            }
+        }
+        Some(used)
+    }
+
+    /// Exact imported input snapshots held by this checked continuation.
+    pub fn imported_dependencies(&self) -> &[super::imports::Dependency] {
+        &self.state.as_ref().expect("checked request is consumed").imported_dependencies
+    }
+
+    /// Keep the freshly checked native bodies when publication can reuse the
+    /// executable bytes. A later relink may still need to generate their code.
+    #[cfg(feature = "exclusive-native")]
+    pub(crate) fn retain_executable_ir(&mut self) {
+        let state = self.state.as_mut().expect("checked request is consumed");
+        if state.program.gx.has_generics { return; }
+        let front = &self.session.front;
+        let caches = &mut self.session.caches;
+        let mut file_hashes = FxMap::default();
+        for (&i, (body, _)) in state.work.iter().zip(&mut state.results) {
+            let slot = front.fn_slot[i] as usize;
+            if caches.has_out[slot] { continue; }
+            let Some(body) = body.take() else { continue };
+            let body = body.attach(&state.program);
+            let file = state.program.fn_def(LocalDefId(i as u32)).name_span.file;
+            let hash = *file_hashes.entry(file).or_insert_with(|| file_text_hash(&state.map, file));
+            let fingerprint = super::ir_cache::ir_fingerprint(
+                &state.program, &body, &state.map, state.fn_lines_all[i],
+            );
+            let mut cached = super::ir_cache::cache_body(
+                &state.program, &body, hash, slot as u32, Vec::new(), fingerprint,
+            );
+            cached.pending_codegen = true;
+            caches.slot_ir[slot] = Some(cached);
+        }
+    }
+
+    /// Consume the same checked state once. A check finishes without emitting;
+    /// a build enters the original generator, object builder and linker.
+    pub fn emit(mut self) -> Response {
+        let state = self.state.take().expect("checked request is consumed");
+        let response = super::mixed_response(self.request, emit_checked(self.request, self.session, state));
+        if super::item_oracle::on() {
+            super::item_oracle::compare_response(self.request, self.session, &response);
+        }
+        response
+    }
+
+    fn emit_unobserved(mut self) -> Response {
+        let state = self.state.take().expect("checked request is consumed");
+        emit_checked(self.request, self.session, state)
+    }
+}
