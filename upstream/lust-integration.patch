diff --git a/tests/pass/std_unix_path_bounds.rs b/tests/pass/std_unix_path_bounds.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8c753c5ce62ffbb6a577f1554bb330fce9bf7e0c
--- /dev/null
+++ b/tests/pass/std_unix_path_bounds.rs
@@ -0,0 +1,78 @@
+// A pathname reserves one byte of sockaddr_un.sun_path for its terminator.
+// Linux has 108 path bytes; Darwin has 104. Count bytes, not Unicode chars.
+use std::io::ErrorKind;
+#[cfg(target_os = "linux")]
+use std::os::linux::net::SocketAddrExt;
+use std::os::unix::net::{SocketAddr, UnixListener, UnixStream};
+use std::path::Path;
+
+fn round_trip(path: &str) {
+    let addr = SocketAddr::from_pathname(path).unwrap();
+    assert_eq!(addr.as_pathname(), Some(Path::new(path)));
+    let _ = std::fs::remove_file(path);
+    let listener = UnixListener::bind_addr(&addr).unwrap();
+    let client = UnixStream::connect_addr(&addr).unwrap();
+    let (server, peer) = listener.accept().unwrap();
+    assert!(peer.is_unnamed());
+    assert_eq!(listener.local_addr().unwrap().as_pathname(), Some(Path::new(path)));
+    assert_eq!(client.peer_addr().unwrap().as_pathname(), Some(Path::new(path)));
+    drop(server);
+    drop(client);
+    drop(listener);
+    std::fs::remove_file(path).unwrap();
+}
+
+fn main() {
+    let capacity = if cfg!(target_os = "macos") { 104usize } else { 108usize };
+    let maximum = capacity - 1;
+    let ascii = "p".repeat(maximum);
+    round_trip(&ascii);
+    let unicode = format!("{}x", "é".repeat(maximum / 2));
+    assert_eq!(unicode.len(), maximum);
+    round_trip(&unicode);
+
+    // Include every byte count that the previous Linux bound wrongly admitted
+    // on Darwin, plus both targets' immediately adjacent bounds.
+    for n in [103usize, 104, 105, 106, 107, 108, 109] {
+        let path = "p".repeat(n);
+        let result = SocketAddr::from_pathname(&path);
+        assert_eq!(result.is_ok(), n < capacity);
+        if n >= capacity {
+            assert_eq!(result.unwrap_err().kind(), ErrorKind::InvalidInput);
+            assert_eq!(UnixListener::bind(&path).unwrap_err().kind(), ErrorKind::InvalidInput);
+            assert_eq!(UnixStream::connect(&path).unwrap_err().kind(), ErrorKind::InvalidInput);
+        }
+    }
+    let too_many_bytes = "é".repeat(capacity / 2);
+    assert_eq!(too_many_bytes.len(), capacity);
+    assert_eq!(SocketAddr::from_pathname(&too_many_bytes).unwrap_err().kind(), ErrorKind::InvalidInput);
+
+    for path in ["\0", "p\0q"] {
+        println!("{:?}", SocketAddr::from_pathname(path).unwrap_err());
+        assert_eq!(UnixListener::bind(path).unwrap_err().kind(), ErrorKind::InvalidInput);
+        assert_eq!(UnixStream::connect(path).unwrap_err().kind(), ErrorKind::InvalidInput);
+    }
+    let empty = SocketAddr::from_pathname("").unwrap();
+    assert!(empty.is_unnamed());
+    assert_eq!(empty.as_pathname(), None);
+    println!("{:?}", empty);
+    #[cfg(target_os = "linux")]
+    {
+        // An empty abstract name is named, unlike an empty pathname or an
+        // unbound endpoint. Check the address after the kernel round trip.
+        let addr = SocketAddr::from_abstract_name("").unwrap();
+        let listener = UnixListener::bind_addr(&addr).unwrap();
+        let local = listener.local_addr().unwrap();
+        assert!(!local.is_unnamed());
+        assert_eq!(local.as_abstract_name(), Some(&b""[..]));
+        let client = UnixStream::connect_addr(&addr).unwrap();
+        let (server, peer) = listener.accept().unwrap();
+        assert!(peer.is_unnamed());
+        assert_eq!(client.peer_addr().unwrap().as_abstract_name(), Some(&b""[..]));
+        drop(server);
+        drop(client);
+        drop(listener);
+        println!("empty abstract socket round trip passed");
+    }
+    println!("pathname bounds and real maximum-length socket round trips passed");
+}
diff --git a/tests/pass/string_collect_pinned_semantics.rs b/tests/pass/string_collect_pinned_semantics.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1fdb726b5f9463d88ad3b019cbe5e31bc63d2a7b
--- /dev/null
+++ b/tests/pass/string_collect_pinned_semantics.rs
@@ -0,0 +1,56 @@
+// Rust source 5b7b37aef: FromIterator<char> allocates from its first
+// size_hint, then Extend<char> asks again. References use String::new
+// and Extend<char> only. These calls and capacities are observable.
+struct Chars {
+    next: u8,
+    end: u8,
+}
+
+impl Iterator for Chars {
+    type Item = char;
+
+    fn next(&mut self) -> Option<char> {
+        if self.next == self.end {
+            None
+        } else {
+            let c = char::from(b'a' + self.next);
+            self.next += 1;
+            Some(c)
+        }
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        println!("hint {} {}", self.next, self.end);
+        let remaining = (self.end - self.next) as usize;
+        (remaining, Some(remaining))
+    }
+}
+
+fn main() {
+    let owned: String = ['a', 'b'].into_iter().collect();
+    assert_eq!(owned, "ab");
+    assert_eq!(owned.capacity(), 2);
+    let source = ['a', 'b'];
+    let borrowed: String = source.iter().collect();
+    assert_eq!(borrowed, "ab");
+    assert_eq!(borrowed.capacity(), 8);
+    println!("owned {} borrowed {}", owned.capacity(), borrowed.capacity());
+
+    let collected: String = Chars { next: 0, end: 3 }.collect();
+    assert_eq!(collected, "abc");
+    assert_eq!(collected.capacity(), 3);
+    println!("collected {} {}", collected, collected.capacity());
+    let empty: String = Chars { next: 0, end: 0 }.collect();
+    assert_eq!(empty.capacity(), 0);
+    println!("empty {}", empty.capacity());
+
+    let mut extended = String::new();
+    extended.extend(Chars { next: 0, end: 3 });
+    assert_eq!(extended, "abc");
+    assert_eq!(extended.capacity(), 8);
+    println!("extended {} {}", extended, extended.capacity());
+
+    let utf8: String = ['a', '\u{00e9}', '\u{1f600}'].into_iter().collect();
+    assert_eq!(utf8, "a\u{00e9}\u{1f600}");
+    println!("utf8 {} {}", utf8.len(), utf8.capacity());
+}
