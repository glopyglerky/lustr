+            &compiler_id.0.to_le_bytes(),
+            &compiler_id.1.to_le_bytes(),
+            &[debug as u8],
+            target.as_bytes(),
+            session.as_bytes(),
+            obj_dir.as_os_str().as_encoded_bytes(),
