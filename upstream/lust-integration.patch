diff --git a/tests/fail/macro_fragment_box_removed.rs b/tests/fail/macro_fragment_box_removed.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e9f9f6de50c1dd772ead4022d6d7ae708b65c06a
--- /dev/null
+++ b/tests/fail/macro_fragment_box_removed.rs
@@ -0,0 +1,10 @@
+// expect: L0806
+// Rust source 5b7b37aef removed box patterns, including discarded
+// pattern fragments. A token-tree fallback cannot hide that error.
+macro_rules! classify {
+    ($pattern:pat) => { "pattern" };
+    ($($tokens:tt)*) => { "tokens" };
+}
+fn main() {
+    println!("{}", classify!(box value));
+}
