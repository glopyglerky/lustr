+++ b/tests/unwind/drop_partial_move_double_panic.rs
@@ -0,0 +1,27 @@
+// A second destructor panic while completing a partial drop must abort.
+// Catching the first panic must not turn the second one into a recoverable
+// result or continue executing user code after catch_unwind.
+use std::panic;
+
+struct D(u8);
+
+impl Drop for D {
+    fn drop(&mut self) {
+        println!("drop {}", self.0);
+        if self.0 == 1 || self.0 == 2 {
+            panic!("destructor {}", self.0);
+        }
+    }
+}
+
+fn partial() {
+    let a = [D(0), D(1), D(2), D(3)];
+    let [moved, _, _, _] = a;
+    std::mem::forget(moved);
+}
+
+fn main() {
+    panic::set_hook(Box::new(|_| println!("panic")));
+    let _ = panic::catch_unwind(partial);
+    println!("unexpected recovery");
+}
diff --git a/tests/unwind/drop_partial_move_panic_order.rs b/tests/unwind/drop_partial_move_panic_order.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7dc71560a8d472640d7d804b60120b11daea10fd
--- /dev/null
+++ b/tests/unwind/drop_partial_move_panic_order.rs
@@ -0,0 +1,120 @@
+// After a partial move, a destructor panic must not skip the remaining
+// elements or fields. Cover every move subset and every possible panic
+// position, including a panic position that was moved out or is absent.
+use std::panic;
+
+struct D(u8, u8);
+
+impl Drop for D {
+    fn drop(&mut self) {
+        println!("drop {}", self.0);
+        if self.0 == self.1 {
+            panic!("destructor");
+        }
+    }
+}
+
+fn elements(mask: u8, panic_at: u8) {
+    let a = [D(0, panic_at), D(1, panic_at), D(2, panic_at), D(3, panic_at)];
+    if mask & 1 != 0 {
+        let [x, _, _, _] = a;
+        std::mem::forget(x);
+    }
+    if mask & 2 != 0 {
+        let [_, x, _, _] = a;
+        std::mem::forget(x);
+    }
+    if mask & 4 != 0 {
+        let [_, _, x, _] = a;
+        std::mem::forget(x);
+    }
+    if mask & 8 != 0 {
+        let [_, _, _, x] = a;
+        std::mem::forget(x);
+    }
+}
+
+fn fields(mask: u8, panic_at: u8) {
+    let a = [
+        (D(0, panic_at), D(1, panic_at)),
+        (D(2, panic_at), D(3, panic_at)),
+        (D(4, panic_at), D(5, panic_at)),
+        (D(6, panic_at), D(7, panic_at)),
+    ];
+    if mask & 1 != 0 {
+        let [(x, _), _, _, _] = a;
+        std::mem::forget(x);
+    }
+    if mask & 2 != 0 {
+        let [_, (x, _), _, _] = a;
+        std::mem::forget(x);
+    }
+    if mask & 4 != 0 {
+        let [_, _, (x, _), _] = a;
+        std::mem::forget(x);
+    }
+    if mask & 8 != 0 {
+        let [_, _, _, (x, _)] = a;
+        std::mem::forget(x);
+    }
+}
+
+fn ranges(mask: u8, panic_at: u8) {
+    let a = [D(0, panic_at), D(1, panic_at), D(2, panic_at), D(3, panic_at), D(4, panic_at), D(5, panic_at), D(6, panic_at), D(7, panic_at)];
+    if mask & 1 != 0 {
+        let [x, _, _, _, _, _, _, _] = a;
+        std::mem::forget(x);
+    }
+    if mask & 2 != 0 {
+        let [_, _, _, x, _, _, _, _] = a;
+        std::mem::forget(x);
+    }
+}
+
+enum E {
+    A(D, D),
+    B(D, D),
+}
+
+struct P {
+    first: E,
+    last: D,
+}
+
+fn variants(other: bool, panic_at: u8) {
+    let p = P {
+        first: if other { E::B(D(0, panic_at), D(1, panic_at)) } else { E::A(D(0, panic_at), D(1, panic_at)) },
+        last: D(2, panic_at),
+    };
+    if let E::A(x, _) = p.first {
+        std::mem::forget(x);
+    }
+}
+
+fn main() {
+    panic::set_hook(Box::new(|_| {}));
+    for mask in 0..16 {
+        for panic_at in 0..5 {
+            println!("elements {mask} {panic_at}");
+            let result = panic::catch_unwind(|| elements(mask, panic_at));
+            println!("caught {}", result.is_err());
+        }
+        for panic_at in 0..9 {
+            println!("fields {mask} {panic_at}");
+            let result = panic::catch_unwind(|| fields(mask, panic_at));
+            println!("caught {}", result.is_err());
+        }
+    }
+    for mask in 0..4 {
+        for panic_at in 0..9 {
+            println!("ranges {mask} {panic_at}");
+            let result = panic::catch_unwind(|| ranges(mask, panic_at));
+            println!("caught {}", result.is_err());
+        }
+        for other in [false, true] {
+            println!("variants {other} {mask}");
+            let result = panic::catch_unwind(|| variants(other, mask));
+            println!("caught {}", result.is_err());
+        }
+    }
+}
diff --git a/tests/unwind/panic_cleanup_hook.rs b/tests/unwind/panic_cleanup_hook.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a7d4e3b9de37ade755a43895ac0ed0c88d9cb6fa
--- /dev/null
+++ b/tests/unwind/panic_cleanup_hook.rs
@@ -0,0 +1,27 @@
+// Cleanup's final nounwind panic runs the hook before aborting. A
+// custom hook forwarding that panic to the default hook must retain its
+// force-no-backtrace behavior, including with RUST_BACKTRACE=1.
+use std::panic;
+
+struct Bomb;
+impl Drop for Bomb {
+    fn drop(&mut self) {
+        println!("drop");
+        panic!("cleanup");
+    }
+}
+
+fn main() {
+    let previous = panic::take_hook();
+    panic::set_hook(Box::new(move |info| {
+        println!("{} {}", info.payload_as_str().unwrap(), std::thread::panicking());
+        if info.payload_as_str() == Some("panic in a destructor during cleanup") {
+            previous(info);
+        }
+    }));
+    let _ = panic::catch_unwind(|| {
+        let _guard = Bomb;
+        panic!("first");
+    });
+    println!("unexpected recovery");
+}
diff --git a/tests/unwind/unix_socket_path_panic.rs b/tests/unwind/unix_socket_path_panic.rs
new file mode 100644
index 0000000000000000000000000000000000000000..06a679664a05b974c5bac897fb97a48f5448ad77
--- /dev/null
+++ b/tests/unwind/unix_socket_path_panic.rs
@@ -0,0 +1,37 @@
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::Path;
+
+struct PanicPath;
+
+impl AsRef<Path> for PanicPath {
+    fn as_ref(&self) -> &Path {
+        println!("pathname evaluated");
+        panic!("pathname panic")
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn descriptor_count() -> usize {
+    std::fs::read_dir("/proc/self/fd").unwrap().count()
+}
+
+fn main() {
+    std::panic::set_hook(Box::new(|_| {}));
+    #[cfg(target_os = "linux")]
+    let before = descriptor_count();
+    for listener in [false, true] {
+        let result = std::panic::catch_unwind(|| {
+            if listener {
+                UnixListener::bind(PanicPath).map(|_| ())
+            } else {
+                UnixStream::connect(PanicPath).map(|_| ())
+            }
+        });
+        match result {
+            Ok(result) => println!("socket result: {:?}", result),
+            Err(_) => println!("pathname panic caught"),
+        }
+        #[cfg(target_os = "linux")]
+        assert_eq!(descriptor_count(), before, "socket descriptor leaked");
+    }
+}
