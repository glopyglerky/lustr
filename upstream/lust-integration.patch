+pub fn compile_observed(req: &Request, session: &mut Session, observer: Option<&dyn super::PhaseObserver>) -> Response {
+    match prepare_observed(req, session, observer) {
+        Preparation::Ready(prepared) => prepared.emit_unobserved(),
