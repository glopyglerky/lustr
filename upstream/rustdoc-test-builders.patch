 }
+
+
+/// An installed Lustr documentation tool has its own matching Rust sysroot.
+/// The ordinary compiler and the compile-fail builder are separate entries.
+fn lustr_documentation_builders() -> Option<(PathBuf, PathBuf)> {
+    let executable = std::env::current_exe().ok()?;
+    let bin = executable.parent()?;
+    let documentation = bin.parent()?;
+    let libexec = documentation.parent()?;
+    if bin.file_name()? != "bin" || documentation.file_name()? != "lustr-rustdoc"
+        || libexec.file_name()? != "libexec"
+    {
+        return None;
+    }
+    let root = libexec.parent()?;
+    Some((root.join("bin/rustc"), bin.join("lustr-rustdoc-compile-fail")))
+}
